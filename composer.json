{
    "name": "cdm/career-recommendation",
    "description": "AI Career Recommendation System for Colegio de Montalban",
    "type": "project",
    "require": {
        "php": "^8.3",
        "google/auth": "^1.0",
        "guzzlehttp/guzzle": "^7.0",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.10",
        "laravel/tinker": "^3.0",
        "socialiteproviders/google": "^4.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.5",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^12.0"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.4"
        },
        "policy": {
            "advisories": {
                "block": true
            }
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
