import { defineStore } from 'pinia';
import axios from 'axios';

const API_URL = import.meta.env.VITE_API_URL || 'http://localhost:8000';

// Create axios instance with proper configuration
const api = axios.create({
  baseURL: API_URL,
  headers: {
    'Content-Type': 'application/json',
  },
});

// Add token to requests
api.interceptors.request.use((config) => {
  const token = localStorage.getItem('auth_token');
  if (token) {
    config.headers.Authorization = `Bearer ${token}`;
  }
  return config;
});

export const useAuthStore = defineStore('auth', {
  state: () => ({
    user: null,
    token: null,
    isAuthenticated: false,
    studentNumber: null,
    admissionYear: null,
  }),

  getters: {
    getUser: (state) => state.user,
    getToken: (state) => state.token,
    isLoggedIn: (state) => state.isAuthenticated,
    getStudentNumber: (state) => state.studentNumber,
  },

  actions: {
    async register(userData) {
      try {
        const response = await api.post('/api/auth/register', userData);
        this.user = response.data.student;
        this.token = response.data.token;
        this.studentNumber = response.data.student_number;
        this.admissionYear = response.data.admission_year;
        this.isAuthenticated = true;
        localStorage.setItem('auth_token', this.token);
        return response.data;
      } catch (error) {
        const errorMessage = error.response?.data?.message || error.message || 'Registration failed';
        throw new Error(errorMessage);
      }
    },

    async login(credentials) {
      try {
        const response = await api.post('/api/auth/login', credentials);
        this.user = response.data.student;
        this.token = response.data.token;
        this.studentNumber = response.data.student_number || null;
        this.admissionYear = response.data.admission_year || null;
        this.isAuthenticated = true;
        localStorage.setItem('auth_token', this.token);
        return response.data;
      } catch (error) {
        const errorMessage = error.response?.data?.message || error.message || 'Login failed';
        throw new Error(errorMessage);
      }
    },

    async googleLogin(googleToken) {
      try {
        const response = await api.post('/api/auth/google-login', {
          google_token: googleToken,
        });
        this.user = response.data.student;
        this.token = response.data.token;
        this.studentNumber = response.data.student_number;
        this.admissionYear = response.data.admission_year;
        this.isAuthenticated = true;
        localStorage.setItem('auth_token', this.token);
        return response.data;
      } catch (error) {
        const errorMessage = error.response?.data?.message || error.message || 'Google login failed';
        throw new Error(errorMessage);
      }
    },

    async logout() {
      try {
        await api.post('/api/auth/logout', {});
        this.user = null;
        this.token = null;
        this.isAuthenticated = false;
        this.studentNumber = null;
        localStorage.removeItem('auth_token');
      } catch (error) {
        // Still clear auth even if logout fails on backend
        this.user = null;
        this.token = null;
        this.isAuthenticated = false;
        this.studentNumber = null;
        localStorage.removeItem('auth_token');
        throw new Error(error.response?.data?.message || 'Logout failed');
      }
    },

    async getProfile() {
      try {
        const response = await api.get('/api/auth/profile');
        this.user = response.data.student;
        return response.data;
      } catch (error) {
        const errorMessage = error.response?.data?.message || error.message || 'Failed to fetch profile';
        throw new Error(errorMessage);
      }
    },

    loadTokenFromStorage() {
      const token = localStorage.getItem('auth_token');
      if (token) {
        this.token = token;
        this.isAuthenticated = true;
      }
    },
  },
});
